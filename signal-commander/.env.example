# Agora Voice Integration (required for voice mode)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# LLM Services (OpenAI compatible - optional, system works without)
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Slack Webhook (optional, for action notifications)
SLACK_WEBHOOK_URL=

# Database Configuration (optional, defaults to SQLite)
DATABASE_URL=sqlite:///./signal.db

# Redis (optional, for future caching)
REDIS_URL=redis://localhost:6379

# Environment
ENVIRONMENT=development

# Follow-up Service Settings
FOLLOWUP_SCAN_SECONDS=60
FOLLOWUP_STALE_MINUTES=5

# Audio Bridge Mode
AUDIO_BRIDGE_ENABLED=true
PRESENTER_NAME=Presenter

# Agora Webhook Secret (optional)
AGORA_WEBHOOK_SECRET=
