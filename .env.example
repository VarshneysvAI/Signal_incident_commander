# ==============================================================================
# SIGNAL Incident Commander - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Agora Real-Time Voice Integration (Required for Voice Room & Bridge Mode)
# Get from Agora Console: https://console.agora.io/
# ------------------------------------------------------------------------------
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 2. LLM Intelligence Engine (Open-World Dynamic Classification & Grounded Query)
# When set, handles ANY arbitrary incident domain (Kubernetes, AWS, TLS, Kafka, DB...)
# When absent, system falls back to offline deterministic regex parser.
# 
# Option A: OpenAI (Default)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Option B: Groq (Ultra-fast, generous free tier)
# Get key: https://console.groq.com/keys
# OPENAI_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 3. Email Notification & Post-Mortem Delivery
# Automatically dispatches incident reports, causal graph digests, and action items.
# Personal Mail (Gmail App Password) or Corporate SMTP (Exchange / SendGrid / Resend)
# ------------------------------------------------------------------------------
# Default destination email address
NOTIFICATION_EMAIL=your-email@example.com

# Outgoing SMTP Server Settings
# For Gmail: Use smtp.gmail.com:587 with a 16-character Google "App Password"
# (See Google Account -> Security -> 2-Step Verification -> App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=
SMTP_FROM=signal-incident-commander@noreply.com
SMTP_USE_TLS=true

# ------------------------------------------------------------------------------
# 4. Integrations & ChatOps (Optional)
# ------------------------------------------------------------------------------
SLACK_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 5. Core Application Settings
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./signal.db
REDIS_URL=redis://localhost:6379
ENVIRONMENT=development

# Background follow-up scanner
FOLLOWUP_SCAN_SECONDS=60
FOLLOWUP_STALE_MINUTES=5

# Bridge Mode (Meet / Zoom audio routing)
AUDIO_BRIDGE_ENABLED=true
PRESENTER_NAME=Presenter
